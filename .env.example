# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Claude API (required for a real run) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- General ---
REPORTS_DIR=reports
TIMEZONE=Asia/Jerusalem
LOG_LEVEL=INFO

# --- Observability (optional; empty = metrics not pushed) ---
PUSHGATEWAY_URL=

# --- Notifications (optional; leave empty to disable) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
